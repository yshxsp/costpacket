# CodeGraphContext ignore rules for BuildOps Lite / CostPacket.
# Keep dependency, generated, binary, secret, and build output files out of the graph.

# Generic
node_modules/
.git/
.env
.env.*
__pycache__/
venv/
.venv/
env/
.env/

# Next.js / deployment outputs
.next/
out/
build/
dist/
.vercel/

# Test + lint artifacts
coverage/
playwright-report/
test-results/

# Scratch and local graph output
tmp/
.codegraph/

# Binary/media
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.ico
*.webp
*.mp4
*.mp3
*.zip
*.tar
*.gz
*.woff
*.woff2

# Lockfiles
package-lock.json
pnpm-lock.yaml
yarn.lock
