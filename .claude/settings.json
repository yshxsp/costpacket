{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(npm run lint)",
      "Bash(npx tsc --noEmit)",
      "Bash(node --version)",
      "Read",
      "Glob",
      "Grep"
    ]
  },
  "enabledPlugins": {
    "supabase@claude-plugins-official": true
  }
}
