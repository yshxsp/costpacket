# Node development against Neon or a local PostgreSQL server.
COSTPACKET_LOCAL=1
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
# Optional: separate database owner URL for migrations, never a Worker secret.
# MIGRATION_DATABASE_URL=
BETTER_AUTH_URL=http://127.0.0.1:3187
BETTER_AUTH_SECRET=GENERATE_A_SECRET
# Optional local email capture. Never enable this in a cloud deployment.
DEV_EMAIL_OUTBOX=.data/outbox.jsonl
# Optional receipt extraction; manual entry remains available.
GEMINI_API_KEY=
# Optional transactional email. Needed for email verification/invitation acceptance.
RESEND_API_KEY=
EMAIL_FROM=CostPacket <onboarding@resend.dev>
# Optional Paddle subscriptions; payout records never move money.
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID=
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
