{
  "name": "costpacket",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv",
    "test:rls": "node supabase/tests/run-test.mjs rls.test.sql",
    "test:tenant": "node supabase/tests/run-test.mjs tenant-integrity.test.sql",
    "test:invite": "node supabase/tests/run-test.mjs invites.test.sql",
    "test:payout": "node supabase/tests/run-test.mjs payout.test.sql",
    "test:billing": "node supabase/tests/run-test.mjs billing.test.sql",
    "test:paywall": "node supabase/tests/run-test.mjs paywall.test.sql",
    "test:paddle": "node tests/paddle-signature.test.mjs",
    "test:files": "node tests/file-csv.test.mjs",
    "test:unit": "npm run test:paddle && npm run test:files",
    "test:db": "npm run test:rls && npm run test:tenant && npm run test:invite && npm run test:payout && npm run test:billing && npm run test:paywall"
  },
  "dependencies": {
    "@paddle/paddle-js": "^1.4.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.577.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "postgres": "^3.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.95.0"
  }
}
